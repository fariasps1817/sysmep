# ===== SysMEP — variáveis de ambiente =====
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NÃO vai para o GitHub (está no .gitignore).

# Banco de dados Neon (Postgres serverless)
# Crie um projeto grátis em https://neon.tech e cole aqui a "connection string".
NEON_DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Segredo para assinar o login (JWT). Use uma frase longa e aleatória.
JWT_SECRET="troque-por-uma-frase-bem-longa-e-aleatoria"

# Operador inicial (criado pelo seed). Troque a senha depois.
SEED_ADMIN_EMAIL="coordenacao@paroquia.com"
SEED_ADMIN_SENHA="mudar123"
SEED_ADMIN_NOME="Coordenação"

# WhatsApp ENVIAME (https://app.enviame.com.br)
ENVIAME_URL="https://api.enviame.com.br/whatsapp/enviar/texto"
ENVIAME_INSTANCIA=""
ENVIAME_TOKEN=""
